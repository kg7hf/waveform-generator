+    const int32_t  fs       = 8000;
+    const int32_t  bufsize  = BUF_SIZE;
+    const uint32_t seed_u   = seed;
+    const double   snr_db   = m_params.noise.snr;
+    const int32_t  has_awgn = m_params.noise.has_awgn ? 1 : 0;
+    const double   rms_max  = RMS_MAXAMPLITUDE;
+    const int32_t  np       = numpaths;
+    std::fwrite(magic,     1,              8, m_truth_file);
