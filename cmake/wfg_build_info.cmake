# Refresh firmware Git identity at configure time and before every build.
# The generated header is rewritten only when its values change.

if(CMAKE_SCRIPT_MODE_FILE)
    cmake_minimum_required(VERSION 3.27)
endif()

function(wfg_write_if_changed path content)
    set(previous "")
    if(EXISTS "${path}")
        file(READ "${path}" previous)
    endif()
    if(NOT "${previous}" STREQUAL "${content}")
        string(REGEX REPLACE "\n$" "" wfg_text "${content}")
        file(CONFIGURE OUTPUT "${path}" CONTENT "@wfg_text@" @ONLY NEWLINE_STYLE UNIX)
    endif()
endfunction()

function(wfg_write_build_info source_dir git plugins header)
    set(commit "unknown")
    set(commit_hi "0x00000000U")
    set(commit_lo "0x00000000U")
    set(dirty unknown)
    # A tree without its own .git entry must not report an enclosing repository.
    if(git AND EXISTS "${source_dir}/.git")
        execute_process(COMMAND "${git}" rev-parse HEAD
            WORKING_DIRECTORY "${source_dir}"
            RESULT_VARIABLE result OUTPUT_VARIABLE head ERROR_QUIET
            OUTPUT_STRIP_TRAILING_WHITESPACE)
        string(LENGTH "${head}" head_length)
        if(result EQUAL 0 AND head_length EQUAL 40 AND head MATCHES "^[0-9a-f]+$")
            set(commit "${head}")
            string(SUBSTRING "${head}" 0 8 commit_hi)
            string(SUBSTRING "${head}" 8 8 commit_lo)
            set(commit_hi "0x${commit_hi}U")
            set(commit_lo "0x${commit_lo}U")
            execute_process(COMMAND "${git}" --no-optional-locks status --porcelain --untracked-files=no
                WORKING_DIRECTORY "${source_dir}"
                RESULT_VARIABLE result OUTPUT_VARIABLE changes ERROR_QUIET)
            if(result EQUAL 0)
                if(changes STREQUAL "")
                    set(dirty clean)
                else()
                    set(dirty modified)
                endif()
            endif()
        endif()
    endif()
    # Private plugin sources are outside the commit named above.
    if(plugins AND dirty STREQUAL "clean")
        set(dirty clean_with_plugins)
    endif()
    string(CONCAT content
        "// Generated by cmake/wfg_build_info.cmake on every build; do not edit.\n"
        "// Guide: docs/modules/build-and-dependencies.md\n"
        "// Types and meanings: rt1170/build_identity.hpp.\n"
        "#pragma once\n\n"
        "#include \"rt1170/build_identity.hpp\"\n\n"
        "#include <cstdint>\n#include <string_view>\n\n"
        "namespace waveform_generator::build_info\n{\n"
        "inline constexpr std::string_view fw_commit{\"${commit}\"};\n"
        "inline constexpr std::uint32_t fw_commit_hi{${commit_hi}};\n"
        "inline constexpr std::uint32_t fw_commit_lo{${commit_lo}};\n"
        "inline constexpr FwDirty fw_dirty{FwDirty::${dirty}};\n"
        "} // namespace waveform_generator::build_info\n")
    wfg_write_if_changed("${header}" "${content}")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
    wfg_write_build_info("${WFG_BUILD_INFO_SOURCE_DIR}" "${WFG_BUILD_INFO_GIT}"
        "${WFG_BUILD_INFO_PLUGINS}" "${WFG_BUILD_INFO_HEADER}")
    return()
endif()

find_package(Git QUIET)
set(WFG_BUILD_INFO_DIR "${CMAKE_BINARY_DIR}/generated")
set(WFG_BUILD_INFO_HEADER "${WFG_BUILD_INFO_DIR}/wfg_build_info.hpp")
wfg_write_build_info("${WFG_ROOT}" "${GIT_EXECUTABLE}" "${WFG_ENABLE_ENCODER_PLUGINS}"
    "${WFG_BUILD_INFO_HEADER}")
add_custom_target(wfg_build_info ALL
    COMMAND "${CMAKE_COMMAND}"
        "-DWFG_BUILD_INFO_SOURCE_DIR=${WFG_ROOT}"
        "-DWFG_BUILD_INFO_GIT=${GIT_EXECUTABLE}"
        "-DWFG_BUILD_INFO_PLUGINS=${WFG_ENABLE_ENCODER_PLUGINS}"
        "-DWFG_BUILD_INFO_HEADER=${WFG_BUILD_INFO_HEADER}"
        -P "${CMAKE_CURRENT_LIST_FILE}"
    BYPRODUCTS "${WFG_BUILD_INFO_HEADER}"
    COMMENT "Refreshing the build identity (Git commit and dirty state)"
    VERBATIM)

function(wfg_use_build_info target)
    add_dependencies(${target} wfg_build_info)
    target_include_directories(${target} PRIVATE "${WFG_BUILD_INFO_DIR}")
endfunction()
