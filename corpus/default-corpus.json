{
  "schema": "signal-lab.corpus/1",
  "corpus_id": "simulated-interference",
  "description": "Deterministic M110B test corpus: six perfect references (300/600/1200 x LONG/SHORT) plus CW, static-crash, fade, sample-slip, AWGN and mixed impairments.",
  "root": "test-vectors/simulated-interference",
  "modes": ["300L", "300S", "600L", "600S", "1200L", "1200S"],
  "reference": {"seconds": 120.0, "tag": ""},
  "extra_references": [{"seconds": 300.0, "tag": "_5min"}],
  "corner_snr_db": {
    "300": 7.0, "600": 7.0, "1200": 11.0,
    "_source": "MIL-STD-188-110B Table 10.1 / JITC Subtest 10 corners as encoded in tools/pathsim-campaign.py CONDITIONS and docs/process/M110-conformance-test-requirements.md (LONG interleaver, two-path fading, SNR in 3 kHz). SHORT rows reuse the LONG corner: they are engineering rows with no Table 10.1 requirement (pathsim-campaign.py SHORT_CONDITIONS). The corpus applies these values as AWGN-only band-limited SNR (pcm_stress convention), so 'corner' is a label, not a conformance claim."
  },
  "seed_base": 0,
  "defaults": {"source_gain_db": -12.0, "clip_policy": "saturate", "reference": "auto"},
  "level_policy": "Every case keeps the source at -12 dB (reference RMS -20.4 dBFS) because the receiver is sensitive to absolute input level in the presence of noise (clean 600L decodes at -40 dB, but corner-SNR noise decodes at -12 dB and fails at -28 dB). Static-crash peaks above full scale therefore saturate exactly as an ADC would; the sidecar reports clipped_samples. The noise_corner_gain-* cases characterise the level sensitivity itself.",
  "cases": [
    {"name": "cw_1800_ci+06", "family": "cw", "severity": "moderate", "seeded": false,
     "impairments": [{"type": "cw", "frequency_hz": 1800, "ci_db": 6}]},
    {"name": "cw_1800_ci+03", "family": "cw", "severity": "severe", "seeded": false,
     "impairments": [{"type": "cw", "frequency_hz": 1800, "ci_db": 3}]},
    {"name": "cw_2100_ci+03", "family": "cw", "severity": "severe", "seeded": false,
     "impairments": [{"type": "cw", "frequency_hz": 2100, "ci_db": 3}]},
    {"name": "cw_1800_ci+00", "family": "cw", "severity": "extreme", "seeded": false, "modes": ["600L"],
     "impairments": [{"type": "cw", "frequency_hz": 1800, "ci_db": 0}]},
    {"name": "cw_0600_ci+10", "family": "cw", "severity": "light", "seeded": false, "modes": ["600L"],
     "impairments": [{"type": "cw", "frequency_hz": 600, "ci_db": 10}]},
    {"name": "cw_1500_ci+03", "family": "cw", "severity": "severe", "seeded": false, "modes": ["600L"],
     "impairments": [{"type": "cw", "frequency_hz": 1500, "ci_db": 3}]},
    {"name": "cw_3000_ci+10", "family": "cw", "severity": "light", "seeded": false, "modes": ["600L"],
     "impairments": [{"type": "cw", "frequency_hz": 3000, "ci_db": 10}]},

    {"name": "impulse_light", "family": "impulse", "severity": "light", "seeded": true,
     "impairments": [{"type": "impulse", "rate_per_sec": 0.2, "peak_db": 12, "decay_ms": 5}]},
    {"name": "impulse_moderate", "family": "impulse", "severity": "moderate", "seeded": true,
     "impairments": [{"type": "impulse", "rate_per_sec": 1.0, "peak_db": 20, "decay_ms": 20}]},
    {"name": "impulse_severe", "family": "impulse", "severity": "severe", "seeded": true,
     "impairments": [{"type": "impulse", "rate_per_sec": 5.0, "peak_db": 30, "decay_ms": 35}]},
    {"name": "impulse_moderate_noise", "family": "impulse", "severity": "moderate", "seeded": true, "modes": ["600L"],
     "description": "moderate static with broadband (band-limited noise) ringing instead of a 1700 Hz tone",
     "impairments": [{"type": "impulse", "rate_per_sec": 1.0, "peak_db": 20, "decay_ms": 20, "ring": "noise"}]},

    {"name": "fade_12db_250ms", "family": "fade", "severity": "light", "seeded": false,
     "impairments": [{"type": "fade", "depth_db": 12, "duration_ms": 250, "shape": "raised_cosine", "first_seconds": 10, "period_seconds": 10}]},
    {"name": "fade_18db_250ms", "family": "fade", "severity": "moderate", "seeded": false,
     "impairments": [{"type": "fade", "depth_db": 18, "duration_ms": 250, "shape": "raised_cosine", "first_seconds": 10, "period_seconds": 10}]},
    {"name": "fade_24db_500ms", "family": "fade", "severity": "severe", "seeded": false,
     "impairments": [{"type": "fade", "depth_db": 24, "duration_ms": 500, "shape": "raised_cosine", "first_seconds": 10, "period_seconds": 10}]},
    {"name": "fade_18db_100ms", "family": "fade", "severity": "light", "seeded": false, "modes": ["600L"],
     "impairments": [{"type": "fade", "depth_db": 18, "duration_ms": 100, "shape": "raised_cosine", "first_seconds": 10, "period_seconds": 10}]},
    {"name": "fade_24db_250ms_rect", "family": "fade", "severity": "severe", "seeded": false, "modes": ["600L"],
     "impairments": [{"type": "fade", "depth_db": 24, "duration_ms": 250, "shape": "rectangular", "first_seconds": 10, "period_seconds": 10}]},

    {"name": "slip_del005_spaced", "family": "sample-slip", "severity": "moderate", "seeded": false,
     "impairments": [{"type": "sample_slip", "kind": "delete", "length_samples": 5, "placement": "spaced", "first_seconds": 15, "period_seconds": 20, "count": 5}]},
    {"name": "slip_del048_clustered", "family": "sample-slip", "severity": "severe", "seeded": false,
     "impairments": [{"type": "sample_slip", "kind": "delete", "length_samples": 48, "placement": "clustered", "first_seconds": 40, "spacing_seconds": 0.5, "count": 5}]},
    {"name": "slip_dup005_spaced", "family": "sample-slip", "severity": "moderate", "seeded": false,
     "impairments": [{"type": "sample_slip", "kind": "duplicate", "length_samples": 5, "placement": "spaced", "first_seconds": 15, "period_seconds": 20, "count": 5}]},
    {"name": "slip_del001_single", "family": "sample-slip", "severity": "light", "seeded": false, "modes": ["600L"],
     "impairments": [{"type": "sample_slip", "kind": "delete", "length_samples": 1, "placement": "single", "at_seconds": 40}]},
    {"name": "slip_dup048_single", "family": "sample-slip", "severity": "severe", "seeded": false, "modes": ["600L"],
     "impairments": [{"type": "sample_slip", "kind": "duplicate", "length_samples": 48, "placement": "single", "at_seconds": 40}]},
    {"name": "slip_dup001_clustered", "family": "sample-slip", "severity": "light", "seeded": false, "modes": ["600L"],
     "impairments": [{"type": "sample_slip", "kind": "duplicate", "length_samples": 1, "placement": "clustered", "first_seconds": 40, "spacing_seconds": 0.5, "count": 5}]},

    {"name": "noise_corner", "family": "noise", "severity": "light", "seeded": true,
     "impairments": [{"type": "awgn", "snr_db": {"corner_offset_db": 0}}]},
    {"name": "noise_corner-02", "family": "noise", "severity": "moderate", "seeded": true,
     "impairments": [{"type": "awgn", "snr_db": {"corner_offset_db": -2}}]},
    {"name": "noise_corner-04", "family": "noise", "severity": "severe", "seeded": true,
     "impairments": [{"type": "awgn", "snr_db": {"corner_offset_db": -4}}]},
    {"name": "noise_corner-08", "family": "noise", "severity": "extreme", "seeded": true, "modes": ["600L"],
     "impairments": [{"type": "awgn", "snr_db": {"corner_offset_db": -8}}]},
    {"name": "noise_corner-12", "family": "noise", "severity": "extreme", "seeded": true, "modes": ["600L"],
     "impairments": [{"type": "awgn", "snr_db": {"corner_offset_db": -12}}]},
    {"name": "noise_corner_gain-18", "family": "noise", "severity": "control", "seeded": true, "modes": ["600L"], "source_gain_db": -18.0,
     "description": "level-sensitivity control: corner SNR with the whole mix 6 dB lower",
     "impairments": [{"type": "awgn", "snr_db": {"corner_offset_db": 0}}]},
    {"name": "noise_corner_gain-24", "family": "noise", "severity": "control", "seeded": true, "modes": ["600L"], "source_gain_db": -24.0,
     "description": "level-sensitivity control: corner SNR with the whole mix 12 dB lower",
     "impairments": [{"type": "awgn", "snr_db": {"corner_offset_db": 0}}]},
    {"name": "noise_corner_gain-28", "family": "noise", "severity": "control", "seeded": true, "modes": ["600L"], "source_gain_db": -28.0,
     "description": "level-sensitivity control: corner SNR with the whole mix 16 dB lower",
     "impairments": [{"type": "awgn", "snr_db": {"corner_offset_db": 0}}]},

    {"name": "mix_MIX001", "family": "mixed", "severity": "light", "seeded": true,
     "description": "MIX-001 mild field noise: corner SNR + CW 2100 Hz C/I +10 + light static",
     "impairments": [{"type": "awgn", "snr_db": {"corner_offset_db": 0}},
                     {"type": "cw", "frequency_hz": 2100, "ci_db": 10},
                     {"type": "impulse", "rate_per_sec": 0.2, "peak_db": 12, "decay_ms": 5}]},
    {"name": "mix_MIX002", "family": "mixed", "severity": "moderate", "seeded": true,
     "description": "MIX-002 moderate: corner-2 + CW 1800 Hz C/I +6 + moderate static",
     "impairments": [{"type": "awgn", "snr_db": {"corner_offset_db": -2}},
                     {"type": "cw", "frequency_hz": 1800, "ci_db": 6},
                     {"type": "impulse", "rate_per_sec": 1.0, "peak_db": 20, "decay_ms": 20}]},
    {"name": "mix_MIX003", "family": "mixed", "severity": "moderate", "seeded": true,
     "description": "MIX-003 fade + interference: corner-2 + 18 dB/250 ms fades + CW 1800 Hz C/I +3",
     "impairments": [{"type": "fade", "depth_db": 18, "duration_ms": 250, "shape": "raised_cosine", "first_seconds": 10, "period_seconds": 10},
                     {"type": "awgn", "snr_db": {"corner_offset_db": -2}},
                     {"type": "cw", "frequency_hz": 1800, "ci_db": 3}]},
    {"name": "mix_MIX004", "family": "mixed", "severity": "moderate", "seeded": true,
     "description": "MIX-004 digital transport damage: corner + moderate static + 5-sample deletions",
     "impairments": [{"type": "awgn", "snr_db": {"corner_offset_db": 0}},
                     {"type": "impulse", "rate_per_sec": 1.0, "peak_db": 20, "decay_ms": 20},
                     {"type": "sample_slip", "kind": "delete", "length_samples": 5, "placement": "spaced", "first_seconds": 15, "period_seconds": 20, "count": 5}]},
    {"name": "mix_MIX005", "family": "mixed", "severity": "severe", "seeded": true,
     "description": "MIX-005 severe composite: corner-4 + 24 dB/250 ms fades + CW 1800 Hz C/I +3 + moderate static + 5-sample deletions",
     "impairments": [{"type": "fade", "depth_db": 24, "duration_ms": 250, "shape": "raised_cosine", "first_seconds": 10, "period_seconds": 10},
                     {"type": "awgn", "snr_db": {"corner_offset_db": -4}},
                     {"type": "cw", "frequency_hz": 1800, "ci_db": 3},
                     {"type": "impulse", "rate_per_sec": 1.0, "peak_db": 20, "decay_ms": 20},
                     {"type": "sample_slip", "kind": "delete", "length_samples": 5, "placement": "spaced", "first_seconds": 15, "period_seconds": 20, "count": 5}]}
  ]
}
